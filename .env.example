# --- LLM provider -------------------------------------------------------
# One of: gemini | groq | openrouter
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=your_openrouter_key_here
# LLM_MODEL=openai/gpt-oss-20b:free   # OpenRouter model id

# Optional: retry transient (429/5xx) failures on a second provider
# LLM_FALLBACK_ENABLED=true
# LLM_FALLBACK_PROVIDER=openrouter

# --- Vector database ----------------------------------------------------
# chroma (local, default) | pinecone
VECTOR_DB=chroma
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- Agent limits (optional) ---------------------------------------------
# MAX_AGENT_ITERATIONS=5
# MAX_REFLECTION_ATTEMPTS=2
# GROUNDING_THRESHOLD=0.70
